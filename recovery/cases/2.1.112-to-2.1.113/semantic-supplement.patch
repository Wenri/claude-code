+    const location = [error.file, error.path].filter(Boolean).join(' › ')
+    issues.push(
+      `- Settings${location ? ` (${location})` : ''}: ${error.message}${error.suggestion ? `\n  Suggested fix: ${error.suggestion}` : ''}`,
