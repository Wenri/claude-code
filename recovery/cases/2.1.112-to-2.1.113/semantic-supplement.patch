+
+function ProjectStep({
+  data,
+  onBack,
+  onSubmit,
+}: {
+  data: VertexWizardData
+  onBack(): void
+  onSubmit(projectId: string): void
+}) {
+  const [projects, setProjects] = useState<string[] | null>(null)
+  const [manual, setManual] = useState(false)
