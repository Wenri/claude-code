+async function reapRemoteTombstones(
+  deletedEntries: Record<string, number>,
+): Promise<number> {
+  const keys = Object.keys(deletedEntries)
+  if (keys.length === 0) return 0
+  const reaped = await Promise.all(
+    keys.map(async relPath => {
+      let validatedPath: string
+      try {
+        validatedPath = await validateTeamMemKey(relPath)
+      } catch {
+        return false
+      }
+      try {
+        await unlink(validatedPath)
+        return true
+      } catch (error) {
+        const code = isErrnoException(error) ? error.code : undefined
+        if (code !== 'ENOENT') {
+          logForDebugging(
+            `team-memory-sync: failed to reap tombstoned "${relPath}": ${code}`,
+            { level: 'warn' },
+          )
+        }
+        return false
+      }
+    }),
+  )
+  return count(reaped, Boolean)
+}
