+async function findStaleReadFileStateEntries(
+  command: string,
+  readFileState: ToolUseContext['readFileState'],
+  commandStartTime: number,
+): Promise<string[]> {
+  if (!WRITE_COMMAND_MARKERS.test(command)) return []
+  const changed: string[] = []
