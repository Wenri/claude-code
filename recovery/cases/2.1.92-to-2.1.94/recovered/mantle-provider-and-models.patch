+      : isEnvTruthy(process.env.CLAUDE_CODE_USE_MANTLE)
+        ? 'mantle'
+        : isEnvTruthy(process.env.CLAUDE_CODE_USE_VERTEX)
+          ? 'vertex'
+          : 'firstParty'
+}
+
+export function getSecondaryAPIProvider(): APIProvider | null {
+  if (
+    getAPIProvider() === 'bedrock' &&
